{
  "name": "notification_service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Consumes platform events, sends transactional email through Resend with exactly-once effect, and tracks delivery outcomes.",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "bun x eslint src/ tests/"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "resend": "^6.35.0",
    "svix": "^2.9.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
